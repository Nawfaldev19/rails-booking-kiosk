{
  "name": "booking-kiosk-web",
  "version": "1.0.0",
  "private": true,
  "description": "Booking Kiosk front ends: the member app and the front-desk kiosk.",
  "author": "Nawfal Imran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nawfaldev19/rails-booking-kiosk.git",
    "directory": "web"
  },
  "homepage": "https://github.com/Nawfaldev19/rails-booking-kiosk#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "dev:member": "npm run dev --workspace @booking-kiosk/member",
    "dev:kiosk": "npm run dev --workspace @booking-kiosk/kiosk",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip"
  },
  "dependencies": {
    "@apollo/client": "^4.3.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
