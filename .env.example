# Environment variables the API and the Vite servers read, with their defaults.
# Nothing loads this file automatically: export the ones you want to change in
# your shell (for example `export PGPORT=5433`) before `make dev`. No real
# secrets are needed to run the demo; production must set SECRET_KEY_BASE itself.

# API (Rails)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PORT=3300
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
MAIL_FROM="Booking Kiosk <no-reply@booking-kiosk.example.com>"
# Origin of the member app, used in invitation links.
MEMBER_APP_URL=http://localhost:5173
# Proxies whose X-Forwarded-For is believed (empty: none). `make dev` sets 127.0.0.1,::1.
TRUSTED_PROXIES=
# Production only:
# SECRET_KEY_BASE=generate-with-bin/rails-secret
# SMTP_ADDRESS=smtp.example.com   SMTP_PORT=587   SMTP_USERNAME=   SMTP_PASSWORD=
# MAIL_DELIVERY=file              (write mail to tmp/mails instead of SMTP)

# Web (Vite dev and preview servers)
BOOKING_KIOSK_API_URL=http://localhost:3300
